!.env.example

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep the versions folder but ignore auto-generated migration files
# (remove this rule if you want to commit migrations)
# alembic/versions/*.py
# !alembic/versions/.gitkeep

# ── Database ──────────────────────────────────────────────────────────────────
*.sqlite3
*.db

# ── Docker ───────────────────────────────────────────────────────────────────
