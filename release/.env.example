# Database
DATABASE_URL=postgresql+asyncpg://kanban:kanban@db:5432/kanban
POSTGRES_PORT=5432

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OTP Settings
OTP_LENGTH=16
OTP_MAX_USES=99
OTP_EXPIRE_DAYS=30

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=true

# Board Settings
COMPLETED_HIDE_DAYS=7

# App
APP_NAME=Kanban
APP_TITLE_SUFFIX=
APP_VERSION=1.0.0
APP_BASE_PATH=
APP_PORT=8000
DEBUG=false
